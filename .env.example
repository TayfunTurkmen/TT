# Copy to .env and fill in. Never commit .env (it is git-ignored).
# For builds that run on Cloudflare (Workers Builds), add the same keys as secrets:
#   npx wrangler secret put ADMIN_PASSWORD_HASH

# --- Admin login (generate with: npm run admin:hash) ---
ADMIN_USERNAME=
# Format: scrypt:<saltHex>:<hashHex>
ADMIN_PASSWORD_HASH=
# Random string, 32+ characters. Changing it signs out every session.
ADMIN_SESSION_SECRET=
# Optional: base32 2FA secret (Admin panel → Security → Generate 2FA key)
ADMIN_TOTP_SECRET=

# --- API secrets (Authorization: Bearer <secret>) ---
CRON_SECRET=
AUTO_BLOG_SECRET=
AUTO_BLOG_PANEL_SECRET=

# --- AI providers (optional) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
